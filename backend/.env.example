# backend/.env.example — committed placeholders; real .env is git-ignored (SEC-12)
# Copy to .env and fill in real values. Never commit real credentials.

# Database connection (app runtime user — DML only)
DB_URL=jdbc:mysql://localhost:3306/shoply_db?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=shoply_app
DB_PASSWORD=shoply_app_dev

# Flyway migration user (DDL only)
FLYWAY_USER=shoply_migrator
FLYWAY_PASSWORD=shoply_migrator_dev

# JWT signing key (>= 32 bytes)
JWT_SECRET=your-jwt-secret-key-at-least-32-bytes-long

# CORS allowed origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Upload directory
UPLOAD_DIR=./uploads

# Payment provider: mock or stripe
PAYMENT_PROVIDER=mock

# Stripe (optional, only if PAYMENT_PROVIDER=stripe)
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Server port
SERVER_PORT=8080
